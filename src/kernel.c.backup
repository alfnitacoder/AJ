// ---------------------------
// RTC (Real Time Clock) Driver
// ---------------------------
static int cmos_is_updating(void) {
  outb(0x70, 0x0A);
  return (inb(0x71) & 0x80);
}

static uint8_t cmos_read(uint8_t reg) {
  outb(0x70, reg);
  return inb(0x71);
}

struct datetime {
  uint8_t sec, min, hour, day, month;
  uint16_t year;
};

static void get_datetime(struct datetime *dt) {
  while (cmos_is_updating())
    __asm__ volatile("pause");

  dt->sec = cmos_read(0x00);
  dt->min = cmos_read(0x02);
  dt->hour = cmos_read(0x04);
  dt->day = cmos_read(0x07);
  dt->month = cmos_read(0x08);
  dt->year = cmos_read(0x09);

  uint8_t status_b = cmos_read(0x0B);

  // Convert BCD to binary if needed
  if (!(status_b & 0x04)) {
    dt->sec = (uint8_t)((dt->sec & 0x0F) + ((dt->sec / 16) * 10));
    dt->min = (uint8_t)((dt->min & 0x0F) + ((dt->min / 16) * 10));
    dt->hour = (uint8_t)(((dt->hour & 0x0F) + (((dt->hour & 0x70) / 16) * 10)) |
                         (dt->hour & 0x80));
    dt->day = (uint8_t)((dt->day & 0x0F) + ((dt->day / 16) * 10));
    dt->month = (uint8_t)((dt->month & 0x0F) + ((dt->month / 16) * 10));
    dt->year = (uint16_t)((dt->year & 0x0F) + ((dt->year / 16) * 10));
  }

  // Handle 12-hour clock
  if (!(status_b & 0x02) && (dt->hour & 0x80)) {
    dt->hour = (uint8_t)(((dt->hour & 0x7F) + 12) % 24);
  }

  dt->year += 2000; // Assume 21st century
}

static uint16_t datetime_to_fat_time(struct datetime *dt) {
  return (uint16_t)(((dt->hour & 0x1F) << 11) | ((dt->min & 0x3F) << 5) |
                    ((dt->sec / 2) & 0x1F));
}

static uint16_t datetime_to_fat_date(struct datetime *dt) {
  uint16_t y = (dt->year >= 1980) ? (uint16_t)(dt->year - 1980) : 0;
  return (uint16_t)((y << 9) | ((dt->month & 0x0F) << 5) | (dt->day & 0x1F));
}

// Forward declarations
static int kstrcmp_n(const char *a, const char *b, size_t n);

static void cmd_date(void) {
  struct datetime dt;
  get_datetime(&dt);

  log_write_u32(dt.year);
  log_putchar('-');
  if (dt.month < 10)
    log_putchar('0');
  log_write_u32(dt.month);
  log_putchar('-');
  if (dt.day < 10)
    log_putchar('0');
  log_write_u32(dt.day);
  log_putchar(' ');
  if (dt.hour < 10)
    log_putchar('0');
  log_write_u32(dt.hour);
  log_putchar(':');
  if (dt.min < 10)
    log_putchar('0');
  log_write_u32(dt.min);
  log_putchar(':');
  if (dt.sec < 10)
    log_putchar('0');
  log_write_u32(dt.sec);
  log_putchar('\n');
}

// System hostname storage
static char system_hostname[64] = "ajos";

static void cmd_uname(const char *args) {
  const char *s = args;
  while (*s && (unsigned char)*s <= ' ')
    s++;

  if (*s == '\0') {
    // Default: show OS name
    log_writestring("AJOS\n");
  } else if (kstrcmp_n(s, "-a", 2) == 0) {
    // Show all information
    log_writestring("AJOS ");
    log_writestring("AJOS ");
    log_writestring("1.0.1 ");
    log_writestring("i386\n");
  } else if (kstrcmp_n(s, "-s", 2) == 0) {
    // Show OS name
    log_writestring("AJOS\n");
  } else if (kstrcmp_n(s, "-r", 2) == 0) {
    // Show release/version
    log_writestring("1.0.1\n");
  } else if (kstrcmp_n(s, "-m", 2) == 0) {
    // Show machine architecture
    log_writestring("i386\n");
  } else {
    log_writestring("Usage: uname [-a|-s|-r|-m]\n");
  }
}

static void cmd_whoami(const char *args) {
  (void)args; // Unused
  // For now, just show a default user (we don't have user system yet)
  log_writestring("root\n");
}

static void cmd_hostname(const char *args) {
  const char *s = args;
  while (*s && (unsigned char)*s <= ' ')
    s++;

  if (*s == '\0') {
    // Show current hostname
    log_writestring(system_hostname);
    log_putchar('\n');
  } else {
    // Set new hostname
    int i = 0;
    while (s[i] && (unsigned char)s[i] > ' ' &&
           i < (int)sizeof(system_hostname) - 1) {
      system_hostname[i] = s[i];
      i++;
    }
    system_hostname[i] = '\0';
    log_writestring("Hostname set to: ");
    log_writestring(system_hostname);
    log_putchar('\n');
  }
}

// ---------------------------
// Paging (very small starter)
// ---------------------------
// We identity-map low memory for now, but protect most kernel pages as
// supervisor-only. User pages (for run3) live in the 0x0030_0000..0x0034_0000
// region.

#define PAGE_SIZE 4096u
#define PTE_P 0x001u
#define PTE_W 0x002u
#define PTE_U 0x004u

static uint32_t page_directory[1024] __attribute__((aligned(4096)));
#define DISK_CACHE_BASE ((uint8_t *)0x80000u)
#define DISK_BOUNCE_PHYS 0x7F000u
static uint32_t page_table0[1024] __attribute__((aligned(4096))); // 0..4MB
static uint32_t page_table1[1024] __attribute__((aligned(4096))); // 4..8MB
static uint32_t page_table2[1024] __attribute__((aligned(4096))); // 8..12MB
static uint32_t page_table3[1024] __attribute__((aligned(4096))); // 12..16MB
static uint32_t page_table_mmio[5][1024] __attribute__((aligned(
    4096))); // Up to 5 devices: 16-20MB, 20-24MB, 24-28MB, 28-32MB, 32-36MB

static int is_user_addr(uint32_t addr) {
  // run3 program + stack region (must match cmd_run3 load/stack)
  return (addr >= 0x00300000u && addr < 0x00340000u);
}

static void paging_init(void) {
  // Clear PD/PTs
  for (uint32_t i = 0; i < 1024; i++) {
    page_directory[i] = 0;
    page_table0[i] = 0;
    page_table1[i] = 0;
    page_table2[i] = 0;
    page_table3[i] = 0;
    for (int j = 0; j < 5; j++) {
      page_table_mmio[j][i] = 0;
    }
  }

  // Identity-map 0..16MB
  for (uint32_t i = 0; i < 1024; i++) {
    uint32_t addr0 = i * PAGE_SIZE;
    uint32_t flags0 = PTE_P | PTE_W | (is_user_addr(addr0) ? PTE_U : 0);
    page_table0[i] = (addr0 & 0xFFFFF000u) | flags0;

    uint32_t addr1 = 0x00400000u + i * PAGE_SIZE;
    page_table1[i] = (addr1 & 0xFFFFF000u) | (PTE_P | PTE_W);

    uint32_t addr2 = 0x00800000u + i * PAGE_SIZE;
    page_table2[i] = (addr2 & 0xFFFFF000u) | (PTE_P | PTE_W);

    uint32_t addr3 = 0x00C00000u + i * PAGE_SIZE;
    page_table3[i] = (addr3 & 0xFFFFF000u) | (PTE_P | PTE_W);
  }

  // PDE[0] must be user-accessible to allow user pages inside 0..4MB.
  // Supervisor-only pages are still protected by their PTE.U=0.
  page_directory[0] = ((uint32_t)page_table0) | (PTE_P | PTE_W | PTE_U);
  page_directory[1] = ((uint32_t)page_table1) | (PTE_P | PTE_W);
  page_directory[2] = ((uint32_t)page_table2) | (PTE_P | PTE_W);
  page_directory[3] = ((uint32_t)page_table3) | (PTE_P | PTE_W);
  // Virtual 0x0100_0000..0x023F_FFFF reserved for mapping up to 5 device MMIO
  // regions (4MB each) Set up page directory entries, but page tables will be
  // populated when devices are found Initialize page tables to point to a safe
  // unmapped page (all zeros = not present) This prevents page faults if
  // something accidentally accesses these regions
  for (int i = 0; i < 5; i++) {
    // Clear the page table first (all entries = 0 = not present)
    for (uint32_t j = 0; j < 1024; j++) {
      page_table_mmio[i][j] = 0;
    }
    // Set up page directory entry pointing to this (empty) page table
    page_directory[4 + i] = ((uint32_t)page_table_mmio[i]) | (PTE_P | PTE_W);
  }

  // Load CR3 and enable paging (CR0.PG)
  __asm__ volatile("mov %0, %%cr3"
                   :
                   : "r"((uint32_t)page_directory)
                   : "memory");
  uint32_t cr0;
  __asm__ volatile("mov %%cr0, %0" : "=r"(cr0));
  cr0 |= 0x80000000u;
  __asm__ volatile("mov %0, %%cr0" : : "r"(cr0));
}

static void paging_map_mmio_4mb(uint32_t virt_base, uint32_t phys_base) {
  // Map 4MB worth of 4KB pages starting at virt_base (must be 4MB aligned)
  // to phys_base (4KB aligned).
  // virt_base must be in range 0x01000000..0x023FFFFF (page directory entries
  // 4-8)
  uint32_t pde_idx = (virt_base >> 22) & 0x3FFu;
  if (pde_idx < 4 || pde_idx >= 9) {
    // Invalid range
    return;
  }
  int table_idx = (int)(pde_idx - 4);
  if (table_idx < 0 || table_idx >= 5) {
    return;
  }

  const uint32_t PT_FLAGS = 0x1B; // P | W | PWT | PCD
  for (uint32_t i = 0; i < 1024; i++) {
    page_table_mmio[table_idx][i] =
        ((phys_base + i * PAGE_SIZE) & 0xFFFFF000u) | 0x1B; // P|W|PWT|PCD
  }
  // Ensure page directory entry is set (should already be set in paging_init,
  // but be safe)
  page_directory[pde_idx] =
      ((uint32_t)page_table_mmio[table_idx]) | (PTE_P | PTE_W);
  // Flush TLB by reloading CR3
  __asm__ volatile("mov %0, %%cr3"
                   :
                   : "r"((uint32_t)page_directory)
                   : "memory");
}

// ---------------------------
// PCI (configuration space via IO ports)
// ---------------------------

static uint32_t pci_cfg_read32(uint8_t bus, uint8_t dev, uint8_t func,
                               uint8_t offset) {
  // offset must be 4-byte aligned
  uint32_t address =
      (uint32_t)(0x80000000u | ((uint32_t)bus << 16) | ((uint32_t)dev << 11) |
                 ((uint32_t)func << 8) | ((uint32_t)(offset & 0xFC)));
  outl(0xCF8, address);
  return inl(0xCFC);
}

static uint16_t pci_cfg_read16(uint8_t bus, uint8_t dev, uint8_t func,
                               uint8_t offset) {
  uint32_t v = pci_cfg_read32(bus, dev, func, (uint8_t)(offset & 0xFC));
  return (uint16_t)((v >> ((offset & 2u) * 8u)) & 0xFFFFu);
}

static uint8_t pci_cfg_read8(uint8_t bus, uint8_t dev, uint8_t func,
                             uint8_t offset) {
  uint32_t v = pci_cfg_read32(bus, dev, func, (uint8_t)(offset & 0xFC));
  return (uint8_t)((v >> ((offset & 3u) * 8u)) & 0xFFu);
}

static void pci_cfg_write32(uint8_t bus, uint8_t dev, uint8_t func,
                            uint8_t offset, uint32_t value) {
  uint32_t address =
      (uint32_t)(0x80000000u | ((uint32_t)bus << 16) | ((uint32_t)dev << 11) |
                 ((uint32_t)func << 8) | ((uint32_t)(offset & 0xFC)));
  outl(0xCF8, address);
  outl(0xCFC, value);
}

static int pci_func_present(uint8_t bus, uint8_t dev, uint8_t func) {
  uint16_t vendor = pci_cfg_read16(bus, dev, func, 0x00);
  return vendor != 0xFFFFu;
}

// ---------------------------
// E1000 (Intel 8254x) bring-up (PIO access)
// ---------------------------

typedef struct {
  int present;
  uint8_t bus, dev, func;
  uint16_t vendor_id, device_id;
  uint16_t io_base;
  uint32_t mmio_phys;
  volatile uint8_t *mmio;
  uint8_t irq_line;
  uint8_t mac[6];
  int enabled;  // Interface enabled/disabled
  char name[8]; // Interface name (eth0, eth1, etc.)
} e1000_dev_t;

// E1000 TX descriptor (legacy)
typedef struct __attribute__((packed)) {
  uint64_t addr;
  uint16_t length;
  uint8_t cso;
  uint8_t cmd;
  uint8_t status;
  uint8_t css;
  uint16_t special;
} e1000_tx_desc_t;

typedef struct __attribute__((packed)) {
  uint64_t addr;
  uint16_t length;
  uint16_t checksum;
  uint8_t status;
  uint8_t errors;
  uint16_t special;
} e1000_rx_desc_t;

#define MAX_E1000_DEVICES 1

#define E1000_TX_RING_SIZE 32
#define E1000_RX_RING_SIZE 32

// Per-device TX/RX rings
typedef struct {
  volatile e1000_tx_desc_t tx_ring[E1000_TX_RING_SIZE]
      __attribute__((aligned(4096)));
  uint8_t tx_bufs[E1000_TX_RING_SIZE][2048] __attribute__((aligned(16)));
  uint32_t tx_tail;

  volatile e1000_rx_desc_t rx_ring[E1000_RX_RING_SIZE]
      __attribute__((aligned(4096)));
  uint8_t rx_bufs[E1000_RX_RING_SIZE][2048] __attribute__((aligned(16)));
  uint32_t rx_head;
} e1000_rings_t;

static e1000_dev_t e1000_devices[MAX_E1000_DEVICES];
static e1000_rings_t e1000_rings[MAX_E1000_DEVICES];
static int e1000_device_count = 0;
static int e1000_default_device = 0; // Default interface to use

// Legacy compatibility: expose first device's MAC
uint8_t e1000_mac[6] = {0, 0, 0, 0, 0, 0}; // Initialize to zeros

static uint32_t e1000_io_read(uint16_t io_base, uint16_t reg) {
  // IOADDR/IODATA
  outl(io_base, (uint32_t)reg);
  return inl((uint16_t)(io_base + 4));
}

static void e1000_io_write(uint16_t io_base, uint16_t reg, uint32_t v) {
  outl(io_base, (uint32_t)reg);
  outl((uint16_t)(io_base + 4), v);
}

static uint32_t e1000_mmio_read(volatile uint8_t *base, uint32_t reg) {
  return *(volatile uint32_t *)(base + reg);
}

static void e1000_mmio_write(volatile uint8_t *base, uint32_t reg, uint32_t v) {
  *(volatile uint32_t *)(base + reg) = v;
}

static void e1000_tx_init(int dev_idx) {
  if (dev_idx < 0 || dev_idx >= e1000_device_count ||
      !e1000_devices[dev_idx].present || !e1000_devices[dev_idx].mmio) {
    return;
  }

  e1000_dev_t *dev = &e1000_devices[dev_idx];
  e1000_rings_t *rings = &e1000_rings[dev_idx];

  // Initialize TX descriptors
  for (uint32_t i = 0; i < E1000_TX_RING_SIZE; i++) {
    rings->tx_ring[i].addr = (uint32_t)&rings->tx_bufs[i][0];
    rings->tx_ring[i].length = 0;
    rings->tx_ring[i].cso = 0;
    rings->tx_ring[i].cmd = 0;
    rings->tx_ring[i].status = 0x1; // DD
    rings->tx_ring[i].css = 0;
    rings->tx_ring[i].special = 0;
  }
  rings->tx_tail = 0;

  // Registers (8254x style)
  const uint32_t REG_TDBAL = 0x3800;
  const uint32_t REG_TDBAH = 0x3804;
  const uint32_t REG_TDLEN = 0x3808;
  const uint32_t REG_TDH = 0x3810;
  const uint32_t REG_TDT = 0x3818;
  const uint32_t REG_TCTL = 0x0400;
  const uint32_t REG_TIPG = 0x0410;

  uint32_t ring_phys = (uint32_t)&rings->tx_ring[0];

  e1000_mmio_write(dev->mmio, REG_TDBAL, ring_phys);
  e1000_mmio_write(dev->mmio, 0x3804, 0); // TDBAH
  e1000_mmio_write(dev->mmio, REG_TDLEN,
                   (uint32_t)(sizeof(e1000_tx_desc_t) * E1000_TX_RING_SIZE));
  e1000_mmio_write(dev->mmio, REG_TDH, 0);
  e1000_mmio_write(dev->mmio, REG_TDT, 0);

  // TCTL: enable, pad short packets, collision threshold/cold
  uint32_t tctl = 0;
  tctl |= (1u << 1);     // EN
  tctl |= (1u << 3);     // PSP
  tctl |= (0x10u << 4);  // CT
  tctl |= (0x40u << 12); // COLD
  e1000_mmio_write(dev->mmio, REG_TCTL, tctl);

  // TIPG recommended defaults for 1Gb
  e1000_mmio_write(dev->mmio, REG_TIPG, 0x0060200Au);
}

int e1000_tx_send_raw(const uint8_t *frame, uint16_t len) {
  // Use default device for backward compatibility
  int dev_idx = e1000_default_device;
  if (dev_idx < 0 || dev_idx >= e1000_device_count ||
      !e1000_devices[dev_idx].present || !e1000_devices[dev_idx].mmio ||
      !e1000_devices[dev_idx].enabled) {
    return 0;
  }

  e1000_dev_t *dev = &e1000_devices[dev_idx];
  e1000_rings_t *rings = &e1000_rings[dev_idx];

  uint16_t original_len = len;
  if (len < 60) {
    // Ethernet minimum (without FCS)
    len = 60;
  }
  if (len > 1500) {
    return 0;
  }

  uint32_t idx = rings->tx_tail % E1000_TX_RING_SIZE;
  volatile e1000_tx_desc_t *d = &rings->tx_ring[idx];
  if ((d->status & 0x1u) == 0) {
    // Not done yet
    return 0;
  }

  // Copy frame into DMA buffer, pad with zeros if needed
  for (uint16_t i = 0; i < len; i++) {
    if (i < original_len) {
      rings->tx_bufs[idx][i] = frame[i];
    } else {
      rings->tx_bufs[idx][i] = 0;
    }
  }

  d->length = len;
  d->cmd = 0x1u | 0x2u | 0x8u; // EOP | IFCS | RS
  d->status = 0;

  // Advance TDT
  const uint32_t REG_TDT = 0x3818;
  uint32_t next = (idx + 1u) % E1000_TX_RING_SIZE;
  e1000_mmio_write(dev->mmio, REG_TDT, next);
  rings->tx_tail = next;

  // Poll for completion briefly
  for (uint32_t spin = 0; spin < 200000u; spin++) {
    if (d->status & 0x1u) {
      return 1;
    }
    __asm__ volatile("pause");
  }
  return 0;
}

static int e1000_rx_poll_one(void);

static void e1000_irq_handler(struct regs *r) {
  (void)r;
  // Handle IRQ for first device (which registered the handler)
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio) {
    return;
  }
  e1000_dev_t *dev = &e1000_devices[0];
  // log_writestring("E1000 IRQ\n");

  const uint32_t REG_ICR = 0x00C0;
  uint32_t icr = e1000_mmio_read(dev->mmio, REG_ICR);
  if (icr == 0)
    return;

  // ACK only. RX is polled from the PIT timer as a fallback path.
  // This avoids racing RX ring processing between NIC IRQ and timer IRQ.
}

static void e1000_rx_init(int dev_idx) {
  if (dev_idx < 0 || dev_idx >= e1000_device_count ||
      !e1000_devices[dev_idx].present || !e1000_devices[dev_idx].mmio) {
    return;
  }

  e1000_dev_t *dev = &e1000_devices[dev_idx];
  e1000_rings_t *rings = &e1000_rings[dev_idx];

  for (uint32_t i = 0; i < E1000_RX_RING_SIZE; i++) {
    rings->rx_ring[i].addr = (uint32_t)&rings->rx_bufs[i][0];
    rings->rx_ring[i].status = 0;
    rings->rx_ring[i].errors = 0;
    rings->rx_ring[i].length = 0;
    rings->rx_ring[i].checksum = 0;
    rings->rx_ring[i].special = 0;
  }
  rings->rx_head = 0;

  const uint32_t REG_RDBAL = 0x2800;
  const uint32_t REG_RDBAH = 0x2804;
  const uint32_t REG_RDLEN = 0x2808;
  const uint32_t REG_RDH = 0x2810;
  const uint32_t REG_RDT = 0x2818;
  const uint32_t REG_RCTL = 0x0100;
  const uint32_t REG_IMS = 0x00D0;

  uint32_t ring_phys = (uint32_t)&rings->rx_ring[0];

  e1000_mmio_write(dev->mmio, REG_RDBAL, ring_phys);
  e1000_mmio_write(dev->mmio, 0x2804, 0); // RDBAH
  e1000_mmio_write(dev->mmio, REG_RDLEN,
                   (uint32_t)(sizeof(e1000_rx_desc_t) * E1000_RX_RING_SIZE));
  e1000_mmio_write(dev->mmio, REG_RDH, 0);
  e1000_mmio_write(dev->mmio, REG_RDT, (uint32_t)(E1000_RX_RING_SIZE - 1));

  // Initialize MTA (Multicast Table Array) to 0 to avoid filtering issues
  const uint32_t REG_MTA = 0x5200;
  for (int i = 0; i < 128; i++) {
    e1000_mmio_write(dev->mmio, REG_MTA + (uint32_t)(i * 4), 0);
  }

  // Clear any pending interrupts
  e1000_mmio_read(dev->mmio, 0x00C0); // REG_ICR

  // Register IRQ handler (only for first device to avoid conflicts)
  if (dev_idx == 0 && dev->irq_line > 0 && dev->irq_line < 16) {
    log_writestring("e1000: registering IRQ handler for irq=");
    log_write_u32((uint32_t)dev->irq_line);
    log_putchar('\n');
    register_interrupt_handler(32 + dev->irq_line, e1000_irq_handler);
    pic_unmask_irq(dev->irq_line);

    // Enable only RX-related interrupts (reduce noise):
    // - RXDMT0 (bit 4)
    // - RXO    (bit 6)
    // - RXT0   (bit 7)
    // - SRPD   (bit 16)
    const uint32_t IMS_MASK = (1u << 4) | (1u << 6) | (1u << 7) | (1u << 16);
    e1000_mmio_write(dev->mmio, REG_IMS, IMS_MASK);
    log_writestring("e1000: Interrupts enabled\n");
  } else if (dev_idx > 0) {
    log_writestring("e1000: device ");
    log_writestring(dev->name);
    log_writestring(" using polling mode\n");
  }

  // Set message delays to 0 to trigger interrupts immediately
  // Set message delays to trigger interrupts
  const uint32_t REG_RDTR = 0x2820;
  const uint32_t REG_RADV = 0x282C;
  e1000_mmio_write(dev->mmio, REG_RDTR, 0x80);
  e1000_mmio_write(dev->mmio, REG_RADV, 0x80);

  // RCTL:
  // - Enable receiver (bit 1)
  // - Unicast Promiscuous (bit 3) - receive all unicast
  // - Multicast Promiscuous (bit 4) - receive all multicast
  // - Broadcast Accept (bit 15) - receive broadcast
  // - Strip CRC (bit 26)
  e1000_mmio_write(dev->mmio, REG_RCTL, 0);
  uint32_t rctl = 0;
  rctl |= (1u << 1); // EN
  rctl |= (1u << 2); // SBP
  rctl |= (1u << 3); // UPE
  rctl |= (1u << 4); // MPE
  // rctl |= (1u << 6);  // LBM (Disabled loopback)
  rctl |= (1u << 15); // BAM
  rctl |= (1u << 26); // SECRC
  e1000_mmio_write(dev->mmio, REG_RCTL, rctl);
  (void)rctl;
}

static int e1000_rx_poll_one(void) {
  // Poll all enabled devices
  for (int dev_idx = 0; dev_idx < e1000_device_count; dev_idx++) {
    e1000_dev_t *dev = &e1000_devices[dev_idx];
    if (!dev->present || !dev->mmio || !dev->enabled) {
      continue;
    }

    e1000_rings_t *rings = &e1000_rings[dev_idx];
    uint32_t idx = rings->rx_head % E1000_RX_RING_SIZE;
    volatile e1000_rx_desc_t *d = &rings->rx_ring[idx];
    if ((d->status & 0x1u) == 0) {
      continue;
    }

    uint16_t len = d->length;
    if (len > 2048) {
      len = 2048;
    }

    // Allocate pbuf and copy data
    struct pbuf *p = pbuf_alloc();
    if (p) {
      if (len > PBUF_SIZE)
        len = PBUF_SIZE;
      for (int i = 0; i < len; i++) {
        p->payload[i] = rings->rx_bufs[idx][i];
      }
      p->len = len;
      p->tot_len = len;
      ethernet_input(p);
    }

    // Hand descriptor back to hardware
    d->status = 0;
    const uint32_t REG_RDT = 0x2818;
    e1000_mmio_write(dev->mmio, REG_RDT, idx);
    rings->rx_head = (idx + 1u) % E1000_RX_RING_SIZE;
    return 1; // Found a packet
  }
  return 0; // No packets found
}

static void cmd_e1000loop(const char *arg) {
  // Use first device for backward compatibility
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio) {
    log_writestring("e1000loop: e1000 not ready\n");
    return;
  }
  e1000_dev_t *dev = &e1000_devices[0];
  const char *a = skip_spaces(arg);
  const uint32_t REG_RCTL = 0x0100;
  const uint32_t REG_CTRL = 0x0000;
  uint32_t rctl = e1000_mmio_read(dev->mmio, REG_RCTL);
  if (kstreq(a, "off")) {
    rctl &= ~(3u << 6);
    e1000_mmio_write(dev->mmio, REG_RCTL, rctl);
    // Clear SLU (set-link-up) if it was forced
    uint32_t ctrl = e1000_mmio_read(dev->mmio, REG_CTRL);
    ctrl &= ~(1u << 6);
    e1000_mmio_write(dev->mmio, REG_CTRL, ctrl);
    log_writestring("e1000loop: off\n");
    return;
  }
  if (kstreq(a, "mac")) {
    // RCTL.LBM=2 (MAC loopback) on some models
    rctl &= ~(3u << 6);
    rctl |= (2u << 6);
    e1000_mmio_write(dev->mmio, REG_RCTL, rctl);
    // Force link up
    uint32_t ctrl = e1000_mmio_read(dev->mmio, REG_CTRL);
    ctrl |= (1u << 6);
    e1000_mmio_write(dev->mmio, REG_CTRL, ctrl);
    log_writestring("e1000loop: mac\n");
    return;
  }
  if (kstreq(a, "phy")) {
    // RCTL.LBM=3 (PHY loopback)
    rctl &= ~(3u << 6);
    rctl |= (3u << 6);
    e1000_mmio_write(dev->mmio, REG_RCTL, rctl);
    // Force link up
    uint32_t ctrl = e1000_mmio_read(dev->mmio, REG_CTRL);
    ctrl |= (1u << 6);
    e1000_mmio_write(dev->mmio, REG_CTRL, ctrl);
    log_writestring("e1000loop: phy\n");
    return;
  }
  log_writestring("Usage: e1000loop mac|phy|off\n");
}

static int e1000_eerd_read_word(uint16_t io_base, uint16_t addr,
                                uint16_t *out_word) {
  // EERD: bits [0]=start, [4]=done, [15:8]=addr, [31:16]=data
  const uint16_t REG_EERD = 0x14;
  uint32_t v = (1u << 0) | ((uint32_t)addr << 8);
  e1000_io_write(io_base, REG_EERD, v);
  for (uint32_t i = 0; i < 100000u; i++) {
    uint32_t r = e1000_io_read(io_base, REG_EERD);
    if (r & (1u << 4)) {
      *out_word = (uint16_t)((r >> 16) & 0xFFFFu);
      return 1;
    }
  }
  return 0;
}

static void e1000_force_link(volatile uint8_t *mmio) {
  if (!mmio)
    return;
  const uint32_t REG_CTRL = 0x0000;
  uint32_t ctrl = e1000_mmio_read(mmio, REG_CTRL);
  // Keep this conservative for QEMU E1000:
  // - Do NOT force speed/duplex or toggle link-reset bits (some variants
  // differ).
  // - Just set SLU (Set Link Up) and clear obvious "force" bits.
  ctrl |= (1u << 6);   // SLU
  ctrl &= ~(1u << 2);  // LRST (link reset) must be 0
  ctrl &= ~(1u << 11); // FRCSPD off
  ctrl &= ~(1u << 12); // FRCDPX off
  e1000_mmio_write(mmio, REG_CTRL, ctrl);

  const uint32_t REG_TIPG = 0x0410;
  e1000_mmio_write(mmio, REG_TIPG, 0x0060200A);
}

static void e1000_reset(uint16_t io_base) {
  // CTRL register (0x0000). Bit 26 = RST, Bit 6 = SLU (Set Link Up)
  const uint16_t REG_CTRL = 0x0000;
  e1000_io_write(io_base, REG_CTRL, (1u << 26) | (1u << 6));
  // Wait for reset bit to clear (some emulators need this).
  for (uint32_t i = 0; i < 200000u; i++) {
    uint32_t v = e1000_io_read(io_base, REG_CTRL);
    if ((v & (1u << 26)) == 0) {
      break;
    }
    __asm__ volatile("pause");
  }
  // Small post-reset settle
  for (uint32_t i = 0; i < 50000u; i++) {
    __asm__ volatile("pause");
  }
}

static void e1000_read_mac_from_rar0(uint16_t io_base, uint8_t mac[6]) {
  // RAL/RAH (Receive Address Low/High) for entry 0
  const uint16_t REG_RAL0 = 0x5400;
  const uint16_t REG_RAH0 = 0x5404;
  uint32_t ral = e1000_io_read(io_base, REG_RAL0);
  uint32_t rah = e1000_io_read(io_base, REG_RAH0);

  mac[0] = (uint8_t)(ral & 0xFFu);
  mac[1] = (uint8_t)((ral >> 8) & 0xFFu);
  mac[2] = (uint8_t)((ral >> 16) & 0xFFu);
  mac[3] = (uint8_t)((ral >> 24) & 0xFFu);
  mac[4] = (uint8_t)(rah & 0xFFu);
  mac[5] = (uint8_t)((rah >> 8) & 0xFFu);
}

static void e1000_program_rar0_mmio(volatile uint8_t *mmio,
                                    const uint8_t mac[6]) {
  // Program Receive Address Register 0 and set AV (Address Valid, bit31 of RAH)
  const uint32_t REG_RAL0 = 0x5400;
  const uint32_t REG_RAH0 = 0x5404;
  uint32_t ral = (uint32_t)mac[0] | ((uint32_t)mac[1] << 8) |
                 ((uint32_t)mac[2] << 16) | ((uint32_t)mac[3] << 24);
  uint32_t rah = (uint32_t)mac[4] | ((uint32_t)mac[5] << 8) | (1u << 31); // AV
  e1000_mmio_write(mmio, REG_RAL0, ral);
  e1000_mmio_write(mmio, REG_RAH0, rah);
  // Read back to flush posted writes
  (void)e1000_mmio_read(mmio, REG_RAH0);
}

static void e1000_probe(void) {
  // Initialize all devices
  e1000_device_count = 0;
  for (int i = 0; i < MAX_E1000_DEVICES; i++) {
    e1000_devices[i].present = 0;
    e1000_devices[i].enabled = 0;
    e1000_devices[i].mmio_phys = 0;
    e1000_devices[i].mmio = (volatile uint8_t *)0;
    e1000_devices[i].name[0] = 'e';
    e1000_devices[i].name[1] = 't';
    e1000_devices[i].name[2] = 'h';
    e1000_devices[i].name[3] = '0' + (char)i;
    e1000_devices[i].name[4] = '\0';
  }

  // Scan only the first few PCI buses (QEMU exposes devices on bus 0)
  for (uint16_t bus = 0; bus < 8 && e1000_device_count < MAX_E1000_DEVICES;
       bus++) {
    for (uint8_t dev = 0; dev < 32 && e1000_device_count < MAX_E1000_DEVICES;
         dev++) {
      if (!pci_func_present((uint8_t)bus, dev, 0)) {
        continue;
      }

      uint8_t header = pci_cfg_read8((uint8_t)bus, dev, 0, 0x0E);
      uint8_t multi = (uint8_t)((header & 0x80u) != 0);
      uint8_t max_func = multi ? 8 : 1;

      for (uint8_t func = 0;
           func < max_func && e1000_device_count < MAX_E1000_DEVICES; func++) {
        if (!pci_func_present((uint8_t)bus, dev, func)) {
          continue;
        }

        uint16_t vendor = pci_cfg_read16((uint8_t)bus, dev, func, 0x00);
        uint16_t device = pci_cfg_read16((uint8_t)bus, dev, func, 0x02);
        if (!(vendor == 0x8086u && device == 0x100Eu)) {
          continue;
        }

        // Found an E1000 device - add it to the array
        int dev_idx = e1000_device_count++;
        e1000_dev_t *e = &e1000_devices[dev_idx];

        // Read BAR0..BAR5 and pick the first I/O BAR (bit0=1)
        uint16_t io_base = 0;
        uint32_t mmio_phys = 0;
        for (uint8_t bar = 0; bar < 6; bar++) {
          uint32_t barv = pci_cfg_read32((uint8_t)bus, dev, func,
                                         (uint8_t)(0x10 + bar * 4));
          if (barv & 0x1u) {
            io_base = (uint16_t)(barv & 0xFFFCu);
          } else if (mmio_phys == 0) {
            mmio_phys = (barv & 0xFFFFFFF0u);
          }
        }

        uint8_t irq = pci_cfg_read8((uint8_t)bus, dev, func, 0x3C);

        e->present = 1;
        e->enabled = 1; // Enable by default
        e->bus = (uint8_t)bus;
        e->dev = dev;
        e->func = func;
        e->vendor_id = vendor;
        e->device_id = device;
        e->io_base = io_base;
        e->mmio_phys = mmio_phys;
        e->irq_line = irq;

        // Enable IO space + bus mastering
        uint16_t cmd = pci_cfg_read16((uint8_t)bus, dev, func, 0x04);
        cmd |= 0x0001u; // I/O space
        cmd |= 0x0002u; // Memory space
        cmd |= 0x0004u; // bus master
        uint32_t cmd32 = pci_cfg_read32((uint8_t)bus, dev, func, 0x04);
        cmd32 = (cmd32 & 0xFFFF0000u) | cmd;
        pci_cfg_write32((uint8_t)bus, dev, func, 0x04, cmd32);

        if (io_base != 0) {
          e1000_reset(io_base);
        }

        // Map MMIO BAR if present (each device gets its own virtual address)
        if (mmio_phys != 0) {
          const uint32_t MMIO_VIRT_BASE = 0x01000000u;
          uint32_t virt_base =
              MMIO_VIRT_BASE +
              (uint32_t)(dev_idx * 0x400000u); // 4MB per device
          paging_map_mmio_4mb(virt_base, mmio_phys);
          e->mmio = (volatile uint8_t *)virt_base;
        }

        // Read MAC from EEPROM (words 0,1,2). If EEPROM read fails,
        // fall back to RAL/RAH.
        uint16_t w0 = 0, w1 = 0, w2 = 0;
        if (io_base != 0 && e1000_eerd_read_word(io_base, 0, &w0) &&
            e1000_eerd_read_word(io_base, 1, &w1) &&
            e1000_eerd_read_word(io_base, 2, &w2)) {
          e->mac[0] = (uint8_t)(w0 & 0xFFu);
          e->mac[1] = (uint8_t)((w0 >> 8) & 0xFFu);
          e->mac[2] = (uint8_t)(w1 & 0xFFu);
          e->mac[3] = (uint8_t)((w1 >> 8) & 0xFFu);
          e->mac[4] = (uint8_t)(w2 & 0xFFu);
          e->mac[5] = (uint8_t)((w2 >> 8) & 0xFFu);
        } else if (e->mmio) {
          uint32_t ral = e1000_mmio_read(e->mmio, 0x5400);
          uint32_t rah = e1000_mmio_read(e->mmio, 0x5404);
          e->mac[0] = (uint8_t)(ral & 0xFFu);
          e->mac[1] = (uint8_t)((ral >> 8) & 0xFFu);
          e->mac[2] = (uint8_t)((ral >> 16) & 0xFFu);
          e->mac[3] = (uint8_t)((ral >> 24) & 0xFFu);
          e->mac[4] = (uint8_t)(rah & 0xFFu);
          e->mac[5] = (uint8_t)((rah >> 8) & 0xFFu);
        } else if (io_base != 0) {
          e1000_read_mac_from_rar0(io_base, e->mac);
        } else {
          for (int i = 0; i < 6; i++) {
            e->mac[i] = 0;
          }
        }

        // Populate global e1000_mac for eth layer (use first device)
        if (dev_idx == 0) {
          for (int i = 0; i < 6; i++) {
            e1000_mac[i] = e->mac[i];
          }
          log_writestring("e1000: set global MAC for networking stack\n");
        }

        log_writestring("e1000: ");
        log_writestring(e->name);
        log_writestring(" ready (MAC: ");
        for (int i = 0; i < 6; i++) {
          if (i > 0)
            log_putchar(':');
          log_write_hex8(e->mac[i]);
        }
        log_writestring(")\n");

        // Ensure RAR0 is marked valid (some emulations are picky).
        if (e->mmio) {
          e1000_program_rar0_mmio(e->mmio, e->mac);
          e1000_force_link(e->mmio);
        }

        // Initialize TX/RX rings for this device
        e1000_tx_init(dev_idx);
        e1000_rx_init(dev_idx);
      }
    }
  }

  // Set default device to first found
  if (e1000_device_count > 0) {
    e1000_default_device = 0;
    log_writestring("e1000: found ");
    log_write_u32((uint32_t)e1000_device_count);
    log_writestring(" device(s), default: ");
    log_writestring(e1000_devices[0].name);
    log_putchar('\n');
  }
}

static void pci_list_devices(void) {
  log_writestring("PCI devices:\n");
  for (uint16_t bus = 0; bus < 256; bus++) {
    for (uint8_t dev = 0; dev < 32; dev++) {
      // If function 0 isn't present, no device here.
      if (!pci_func_present((uint8_t)bus, dev, 0)) {
        continue;
      }

      uint8_t header = pci_cfg_read8((uint8_t)bus, dev, 0, 0x0E);
      uint8_t multi = (uint8_t)((header & 0x80u) != 0);
      uint8_t max_func = multi ? 8 : 1;

      for (uint8_t func = 0; func < max_func; func++) {
        if (!pci_func_present((uint8_t)bus, dev, func)) {
          continue;
        }

        uint16_t vendor = pci_cfg_read16((uint8_t)bus, dev, func, 0x00);
        uint16_t device = pci_cfg_read16((uint8_t)bus, dev, func, 0x02);
        uint8_t class_code = pci_cfg_read8((uint8_t)bus, dev, func, 0x0B);
        uint8_t subclass = pci_cfg_read8((uint8_t)bus, dev, func, 0x0A);
        uint8_t prog_if = pci_cfg_read8((uint8_t)bus, dev, func, 0x09);
        uint8_t irq_line = pci_cfg_read8((uint8_t)bus, dev, func, 0x3C);

        log_writestring("  ");
        log_write_u32(bus);
        log_putchar(':');
        log_write_u32(dev);
        log_putchar('.');
        log_write_u32(func);
        log_writestring("  ven=");
        log_write_hex32((uint32_t)vendor);
        log_writestring(" dev=");
        log_write_hex32((uint32_t)device);
        log_writestring(" class=");
        log_write_hex32((uint32_t)class_code);
        log_putchar(':');
        log_write_hex32((uint32_t)subclass);
        log_putchar(':');
        log_write_hex32((uint32_t)prog_if);
        log_writestring(" irq=");
        log_write_u32((uint32_t)irq_line);

        // Small hint for common QEMU NICs
        if (vendor == 0x8086u && device == 0x100Eu) {
          log_writestring("  (Intel E1000)");
        }
        if (vendor == 0x10ECu && device == 0x8139u) {
          log_writestring("  (Realtek RTL8139)");
        }

        log_putchar('\n');
      }
    }
  }
}

static void e1000_print_info(void) {
  if (e1000_device_count == 0) {
    log_writestring("e1000: no devices found\n");
    return;
  }

  // Print info for all devices
  for (int i = 0; i < e1000_device_count; i++) {
    e1000_dev_t *dev = &e1000_devices[i];
    log_writestring(dev->name);
    log_writestring(": bdf=");
    log_write_u32((uint32_t)dev->bus);
    log_putchar(':');
    log_write_u32((uint32_t)dev->dev);
    log_putchar('.');
    log_write_u32((uint32_t)dev->func);
    log_writestring(" io_base=");
    log_write_hex32((uint32_t)dev->io_base);
    log_writestring(" mmio_phys=");
    log_write_hex32((uint32_t)dev->mmio_phys);
    log_writestring(" irq=");
    log_write_u32((uint32_t)dev->irq_line);
    log_writestring(" enabled=");
    log_writestring(dev->enabled ? "yes" : "no");
    if (i == e1000_default_device) {
      log_writestring(" [DEFAULT]");
    }
    log_putchar('\n');

    log_writestring("  mac=");
    for (int j = 0; j < 6; j++) {
      static const char *hex = "0123456789ABCDEF";
      uint8_t b = dev->mac[j];
      log_putchar(hex[(b >> 4) & 0xF]);
      log_putchar(hex[b & 0xF]);
      if (j != 5) {
        log_putchar(':');
      }
    }
    log_putchar('\n');

    if (dev->mmio) {
      uint32_t ral = e1000_mmio_read(dev->mmio, 0x5400);
      uint32_t rah = e1000_mmio_read(dev->mmio, 0x5404);
      log_writestring("  rar0: ral=");
      log_write_hex32(ral);
      log_writestring(" rah=");
      log_write_hex32(rah);
      log_putchar('\n');
    }
  }
}

static void cmd_e1000tx(void) {
  // Use first device for backward compatibility
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio) {
    log_writestring("e1000tx: e1000 not ready\n");
    return;
  }
  e1000_dev_t *dev = &e1000_devices[0];

  // Build a simple Ethernet frame (ethertype 0x88B5, payload "AJOS").
  // Use dst=self to make loopback testing deterministic.
  uint8_t frame[64];
  for (int i = 0; i < 6; i++) {
    frame[i] = dev->mac[i]; // dst = our MAC
  }
  for (int i = 0; i < 6; i++) {
    frame[6 + i] = dev->mac[i]; // src = our MAC
  }
  frame[12] = 0x88;
  frame[13] = 0xB5;
  const char payload[] = "AJOS E1000 TX TEST";
  uint16_t pay_len = (uint16_t)(sizeof(payload) - 1);
  for (uint16_t i = 0; i < pay_len; i++) {
    frame[14 + i] = (uint8_t)payload[i];
  }
  uint16_t len = (uint16_t)(14 + pay_len);
  // Pad rest with zeros (driver will enforce min length)
  for (uint16_t i = len; i < sizeof(frame); i++) {
    frame[i] = 0;
  }

  int ok = e1000_tx_send_raw(frame, len);
  log_writestring(ok ? "e1000tx: sent\n" : "e1000tx: failed\n");
}

static void cmd_e1000rx(void) {
  int got = e1000_rx_poll_one();
  if (!got) {
    log_writestring("e1000rx: no packet\n");
  }
}

static void cmd_e1000watch(void) {
  // Use first device
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio)
    return;
  e1000_dev_t *dev = &e1000_devices[0];
  log_writestring("Watching desc[0].st (100 samples)...\n");
  uint8_t last_st = 0xFF;
  for (int i = 0; i < 100; i++) {
    e1000_rings_t *rings = &e1000_rings[0];
    uint8_t st = rings->rx_ring[0].status;
    if (st != last_st) {
      log_writestring(" st0=");
      log_write_hex32(st);
      log_putchar('\n');
      last_st = st;
    }
    // Small delay
    for (volatile int j = 0; j < 1000000; j++)
      ;
  }
}

static void cmd_e1000regs(void) {
  // Use first device
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio)
    return;
  e1000_dev_t *dev = &e1000_devices[0];
  log_writestring("E1000 Regs:\n");
  log_writestring("  CTRL=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0000));
  log_writestring("  STATUS=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0008));
  log_putchar('\n');
  log_writestring("  EECD=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0010));
  log_writestring("  EERD=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0014));
  log_putchar('\n');
  log_writestring("  ICR=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x00C0));
  log_writestring("  IMS=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x00D0));
  log_putchar('\n');
  log_writestring("  RCTL=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0100));
  log_writestring("  TCTL=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0400));
  log_putchar('\n');
  log_writestring("  TIPG=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x0410));
  log_writestring("  RDH=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x2810));
  log_writestring("  RDT=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x2818));
  log_putchar('\n');
  log_writestring("  RAL0=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x5400));
  log_writestring("  RAH0=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x5404));
  log_putchar('\n');
}

static void cmd_e1000icr(void) {
  // Use first device
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio)
    return;
  e1000_dev_t *dev = &e1000_devices[0];
  log_writestring("E1000 ICR=");
  log_write_hex32(e1000_mmio_read(dev->mmio, 0x00C0));
  log_putchar('\n');
}

static void cmd_e1000rxstat(void) {
  // Use first device for backward compatibility
  if (e1000_device_count == 0 || !e1000_devices[0].present ||
      !e1000_devices[0].mmio) {
    log_writestring("e1000rxstat: e1000 not ready\n");
    return;
  }
  e1000_dev_t *dev = &e1000_devices[0];
  e1000_rings_t *rings = &e1000_rings[0];

  const uint32_t REG_RCTL = 0x0100;
  const uint32_t REG_RDBAL = 0x2800;
  const uint32_t REG_RDLEN = 0x2808;
  const uint32_t REG_RDH = 0x2810;
  const uint32_t REG_RDT = 0x2818;
  const uint32_t REG_STATUS = 0x0008;

  uint32_t status = e1000_mmio_read(dev->mmio, REG_STATUS);
  uint32_t rctl = e1000_mmio_read(dev->mmio, REG_RCTL);
  uint32_t rdbal = e1000_mmio_read(dev->mmio, REG_RDBAL);
  uint32_t rdlen = e1000_mmio_read(dev->mmio, REG_RDLEN);
  uint32_t rdh = e1000_mmio_read(dev->mmio, REG_RDH);
  uint32_t rdt = e1000_mmio_read(dev->mmio, REG_RDT);

  log_writestring("e1000rxstat: STATUS=");
  log_write_hex32(status);
  log_writestring(" RCTL=");
  log_write_hex32(rctl);
  log_writestring(" MPC=");
  log_write_u32(e1000_mmio_read(dev->mmio, 0x4010));
  log_writestring(" RNBC=");
  log_write_u32(e1000_mmio_read(dev->mmio, 0x40A0));
  log_putchar('\n');

  log_writestring(" RDBAL=");
  log_write_hex32(rdbal);
  log_writestring(" RDLEN=");
  log_write_hex32(rdlen);
  log_writestring(" RDH=");
  log_write_hex32(rdh);
  log_writestring(" RDT=");
  log_write_hex32(rdt);
  log_putchar('\n');

  for (uint32_t i = 0; i < E1000_RX_RING_SIZE; i++) {
    volatile e1000_rx_desc_t *d = &rings->rx_ring[i];
    log_writestring("  [");
    log_write_u32(i);
    log_writestring("] st=");
    log_write_hex32((uint32_t)d->status);
    log_writestring(" len=");
    log_write_u32((uint32_t)d->length);
    log_writestring(" err=");
    log_write_hex32((uint32_t)d->errors);
    log_putchar('\n');
  }
}

static void cmd_e1000reinit(void) {
  if (e1000_device_count == 0) {
    log_writestring("e1000reinit: no devices found\n");
    return;
  }
  // Re-init rings and RX registers for all devices (useful after toggling
  // loopback/link).
  for (int i = 0; i < e1000_device_count; i++) {
    if (e1000_devices[i].present) {
      e1000_tx_init(i);
      e1000_rx_init(i);
    }
  }
  log_writestring("e1000reinit: done\n");
}

// ---------------------------
// Simple heap allocator (kmalloc/kfree)
// ---------------------------

#define HEAP_START 0x00100000u
#define HEAP_SIZE (0x00100000u) // 1 MiB

typedef struct heap_block {
  uint32_t size;           // bytes in payload
  uint32_t is_free;        // 1 = free, 0 = used
  struct heap_block *next; // next block in list
} heap_block_t;

// Use a non-static global to avoid BSS initialization issues
volatile heap_block_t *heap_head = (heap_block_t *)0;

static uint32_t align_up_u32(uint32_t x, uint32_t a) {
  return (x + (a - 1u)) & ~(a - 1u);
}

static void heap_init(void) {
  outb(0x3F8, 'H'); // Debug: heap_init called
  heap_block_t *new_head = (heap_block_t *)((uint32_t)HEAP_START);
  new_head->size = (uint32_t)(HEAP_SIZE - sizeof(heap_block_t));
  new_head->is_free = 1;
  new_head->next = (heap_block_t *)0;

  // Force assignment - use multiple methods to ensure it works
  heap_head = new_head;
  __asm__ volatile("" ::: "memory");

  // Also write directly to memory address
  *(volatile uint32_t *)((uint32_t)&heap_head) = (uint32_t)new_head;
  __asm__ volatile("" ::: "memory");

  // Verify assignment
  uint32_t hh = (uint32_t)heap_head;
  outb(0x3F8, '0' + ((hh >> 20) & 0xF));
  outb(0x3F8, '0' + ((hh >> 16) & 0xF));
  outb(0x3F8, '0' + ((hh >> 12) & 0xF));
  outb(0x3F8, '0' + ((hh >> 8) & 0xF));

  outb(0x3F8, 'I'); // Debug: heap_init complete
}

static void heap_stats(uint32_t *out_total, uint32_t *out_used,
                       uint32_t *out_free) {
  uint32_t total = 0;
  uint32_t used = 0;
  uint32_t freeb = 0;

  heap_block_t *current_head = (heap_block_t *)((volatile uint32_t)heap_head);
  if (current_head == (heap_block_t *)0) {
    if (out_total)
      *out_total = 0;
    if (out_used)
      *out_used = 0;
    if (out_free)
      *out_free = 0;
    return;
  }
  for (heap_block_t *b = current_head; b != (heap_block_t *)0; b = b->next) {
    total += b->size;
    if (b->is_free) {
      freeb += b->size;
    } else {
      used += b->size;
    }
  }

  if (out_total) {
    *out_total = total;
  }
  if (out_used) {
    *out_used = used;
  }
  if (out_free) {
    *out_free = freeb;
  }
}

static void heap_coalesce(void) {
  // Merge adjacent free blocks when they are physically contiguous.
  heap_block_t *current_head = (heap_block_t *)((volatile uint32_t)heap_head);
  for (heap_block_t *b = current_head;
       b != (heap_block_t *)0 && b->next != (heap_block_t *)0;) {
    heap_block_t *n = b->next;
    uint8_t *b_end = (uint8_t *)b + sizeof(heap_block_t) + b->size;
    if (b->is_free && n->is_free && (uint8_t *)n == b_end) {
      b->size += (uint32_t)sizeof(heap_block_t) + n->size;
      b->next = n->next;
      continue;
    }
    b = b->next;
  }
}

void *kmalloc(uint32_t size) {
  // Make heap operations IRQ-safe: networking RX runs in interrupt context,
  // and can allocate/free pbufs. Without this, kmalloc/kfree can be re-entered
  // and corrupt the heap, causing random network failures.
  uint32_t flags = 0;
  __asm__ volatile("pushf\npop %0\ncli" : "=r"(flags) : : "memory");

  // Read heap_head with volatile to ensure we get the actual value
  heap_block_t *current_head = (heap_block_t *)((volatile uint32_t)heap_head);
  if (current_head == (heap_block_t *)0) {
    heap_init();
    // Re-read after init
    current_head = (heap_block_t *)((volatile uint32_t)heap_head);
    if (current_head == (heap_block_t *)0) {
      // Still 0 after init - critical error
      extern void log_writestring(const char *s);
      extern void log_write_hex32(uint32_t v);
      log_writestring(
          "kmalloc: CRITICAL - heap_init failed, heap_head still 0x");
      log_write_hex32((uint32_t)heap_head);
      log_putchar('\n');
      if (flags & (1u << 9))
        __asm__ volatile("sti" : : : "memory");
      return (void *)0;
    }
  }

  if (size == 0) {
    if (flags & (1u << 9))
      __asm__ volatile("sti" : : : "memory");
    return (void *)0;
  }

  // Basic alignment for pointers/headers
  uint32_t orig_size = size;
  size = align_up_u32(size, 8u);

  for (heap_block_t *b = heap_head; b != (heap_block_t *)0; b = b->next) {
    if (!b->is_free || b->size < size) {
      continue;
    }

    // Split if there's enough room for a new header + minimal payload
    uint32_t remaining = b->size - size;
    if (remaining > (uint32_t)(sizeof(heap_block_t) + 8u)) {
      heap_block_t *newb =
          (heap_block_t *)((uint8_t *)b + sizeof(heap_block_t) + size);
      newb->size = remaining - (uint32_t)sizeof(heap_block_t);
      newb->is_free = 1;
      newb->next = b->next;

      b->size = size;
      b->next = newb;
    }

    b->is_free = 0;
    void *ret = (void *)((uint8_t *)b + sizeof(heap_block_t));
    if (flags & (1u << 9))
      __asm__ volatile("sti" : : : "memory");
    return ret;
  }

  // Allocation failed - debug output
  if (orig_size > 4000) {
    extern void log_writestring(const char *s);
    extern void log_write_u32(uint32_t v);
    extern void log_write_hex32(uint32_t v);
    log_writestring("kmalloc: FAILED to allocate ");
    log_write_u32(orig_size);
    log_writestring(" bytes, heap_head=0x");
    log_write_hex32((uint32_t)current_head);
    if (current_head != (heap_block_t *)0) {
      log_writestring(" first_block.size=");
      log_write_u32(current_head->size);
      log_writestring(" first_block.is_free=");
      log_write_u32(current_head->is_free ? 1 : 0);
    }
    log_putchar('\n');
  }

  if (flags & (1u << 9))
    __asm__ volatile("sti" : : : "memory");
  return (void *)0;
}

void kfree(void *ptr) {
  uint32_t flags = 0;
  __asm__ volatile("pushf\npop %0\ncli" : "=r"(flags) : : "memory");

  if (ptr == (void *)0) {
    if (flags & (1u << 9))
      __asm__ volatile("sti" : : : "memory");
    return;
  }

  heap_block_t *b = (heap_block_t *)((uint8_t *)ptr - sizeof(heap_block_t));
  b->is_free = 1;
  heap_coalesce();

  if (flags & (1u << 9))
    __asm__ volatile("sti" : : : "memory");
}

size_t terminal_row = 0;
size_t terminal_column = 0;
static uint8_t terminal_color = VGA_GREEN | (VGA_BLACK << 4);

// ---------------------------
// BIOS-backed sector reads (via real-mode thunk)
// ---------------------------

extern uint32_t bios_int13_read_chs(uint32_t drive, uint32_t cyl, uint32_t head,
                                    uint32_t sect, uint32_t seg, uint32_t off);
extern uint32_t bios_int13_write_chs(uint32_t drive, uint32_t cyl,
                                     uint32_t head, uint32_t sect, uint32_t seg,
                                     uint32_t off);
static void mem_copy(uint8_t *dst, const uint8_t *src, uint32_t n);
static void mem_set(uint8_t *dst, uint8_t v, uint32_t n);

#define FLOPPY_SPT 18u
#define FLOPPY_HEADS 2u
#define SECTOR_SIZE 512u

static int bios_read_sector_lba(uint8_t drive, uint32_t lba, uint8_t *dst512);
static int bios_write_sector_lba(uint8_t drive, uint32_t lba,
                                 const uint8_t *src512);

#define DISK_CACHE_SECTORS 256

static uint8_t boot_drive = 0x00;
volatile uint16_t ramdisk_sectors = 0; // Made non-static to avoid BSS issues
static uint8_t ramdisk_drive = 0x01;
static uint8_t *disk_bounce = (uint8_t *)DISK_BOUNCE_PHYS;

static int ramdisk_read_sector_lba(uint32_t lba, uint8_t *dst512) {
  if (ramdisk_sectors == 0) {
    return 0;
  }
  if (lba >= (uint32_t)ramdisk_sectors) {
    return 0;
  }
  if (lba < DISK_CACHE_SECTORS) {
    // Read from cache at 0x40000 (loaded by bootloader)
    // Check if cache appears to be valid (first byte should not be all zeros
    // for a FAT12 disk)
    uint8_t *cache_ptr = DISK_CACHE_BASE + lba * SECTOR_SIZE;
    mem_copy(dst512, cache_ptr, SECTOR_SIZE);

    // If sector 0 is all zeros, the cache might not have been loaded
    // Fall back to BIOS read
    if (lba == 0) {
      int all_zero = 1;
      for (int i = 0; i < 512; i++) {
        if (dst512[i] != 0) {
          all_zero = 0;
          break;
        }
      }
      if (all_zero) {
        // Cache appears empty, try BIOS read instead
        log_writestring("ramdisk: cache appears empty, trying BIOS read\n");
        return bios_read_sector_lba(ramdisk_drive, lba, dst512);
      }
    }
    return 1;
  }
  // Read from physical disk via BIOS
  return bios_read_sector_lba(ramdisk_drive, lba, dst512);
}

static int ramdisk_write_sector_lba(uint32_t lba, const uint8_t *src512) {
  log_writestring("[Disk] Write LBA ");
  log_write_u32(lba);
  log_writestring("... ");

  if (ramdisk_sectors == 0) {
    log_writestring("FAIL (ramdisk not present)\n");
    return 0;
  }
  if (lba >= (uint32_t)ramdisk_sectors) {
    log_writestring("FAIL (LBA out of bounds)\n");
    return 0;
  }

  // Always write to physical disk
  uint8_t status = bios_write_sector_lba(ramdisk_drive, lba, src512);

  if (status != 0) {
    log_writestring("FAIL (Drive=");
    log_write_hex8(boot_drive);
    log_writestring(", Status AH=");
    log_write_hex8(status);
    log_writestring(")\n");
    // Even if physical write fails, memory ramdisk/cache might still want it?
    // In persistence mode, we usually care more about the physical failure.
    return 0;
  }
  if (lba < DISK_CACHE_SECTORS) {
    mem_copy((uint8_t *)(DISK_CACHE_BASE + lba * SECTOR_SIZE),
             (const uint8_t *)src512, SECTOR_SIZE);
  }

  log_writestring("OK\n");
  return 1;
}

static void lba_to_chs(uint32_t lba, uint16_t *cyl, uint8_t *head,
                       uint8_t *sect) {
  uint32_t tmp = lba;
  uint32_t c = tmp / (FLOPPY_SPT * FLOPPY_HEADS);
  uint32_t r = tmp % (FLOPPY_SPT * FLOPPY_HEADS);
  uint32_t h = r / FLOPPY_SPT;
  uint32_t s = (r % FLOPPY_SPT) + 1u;
  *cyl = (uint16_t)c;
  *head = (uint8_t)h;
  *sect = (uint8_t)s;
}

static int bios_read_sector_lba(uint8_t drive, uint32_t lba, uint8_t *dst512) {
  uint16_t cyl = 0;
  uint8_t head = 0;
  uint8_t sect = 0;
  lba_to_chs(lba, &cyl, &head, &sect);

  uint16_t seg = (uint16_t)(DISK_BOUNCE_PHYS >> 4);
  uint16_t off = (uint16_t)(DISK_BOUNCE_PHYS & 0x0F);

  uint32_t rc =
      bios_int13_read_chs((uint32_t)drive, (uint32_t)cyl, (uint32_t)head,
                          (uint32_t)sect, (uint32_t)seg, (uint32_t)off);
  if ((rc >> 8) != 0) {
    return 0;
  }
  mem_copy(dst512, disk_bounce, SECTOR_SIZE);
  return 1;
}

static int bios_write_sector_lba(uint8_t drive, uint32_t lba,
                                 const uint8_t *src512) {
  uint16_t cyl = 0;
  uint8_t head = 0;
  uint8_t sect = 0;
  lba_to_chs(lba, &cyl, &head, &sect);

  mem_copy(disk_bounce, (uint8_t *)src512, SECTOR_SIZE);

  uint32_t addr = DISK_BOUNCE_PHYS;
  uint16_t seg = (uint16_t)(addr >> 4);
  uint16_t off = (uint16_t)(addr & 0x0F);

  uint32_t rc =
      bios_int13_write_chs((uint32_t)drive, (uint32_t)cyl, (uint32_t)head,
                           (uint32_t)sect, (uint32_t)seg, (uint32_t)off);
  return (uint8_t)(rc >> 8); // Return AH status (0 = success)
}

static void disk_sync_sector_lba(uint32_t lba) {
  // Now redundant with direct BIOS write.
  (void)lba;
}

