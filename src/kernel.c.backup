static void cmd_service(const char *arg) {
  const char *s = skip_spaces(arg);
  if (kstrcmp_n(s, "httpd", 5) == 0) {
    cmd_httpd(skip_spaces(s + 5));
  } else {
    log_writestring("Usage: service <name> [start|stop|restart|status]\n");
    log_writestring("Available services: httpd\n");
  }
}

static void shell_dispatch(const char *line) {
  const char *s = skip_spaces(line);
  if (*s == '\0') {
    return;
  }

  // Check for background job indicator (&) at the end
  int is_background = 0;
  const char *line_end = s;
  while (*line_end != '\0')
    line_end++;
  // Go backwards to find & before any trailing whitespace
  const char *p = line_end - 1;
  while (p >= s && ((unsigned char)*p <= (unsigned char)' ' ||
                    (unsigned char)*p == 0x7Fu)) {
    p--;
  }
  if (p >= s && *p == '&') {
    is_background = 1;
    // Truncate line at & (we'll parse up to this point)
    line_end = p;
  }

  // Parse command token [s, s+cmd_len)
  const char *cmd = s;
  size_t cmd_len = 0;
  while (cmd + cmd_len < line_end &&
         (unsigned char)cmd[cmd_len] > (unsigned char)' ' &&
         (unsigned char)cmd[cmd_len] != 0x7Fu) {
    cmd_len++;
  }

  const char *rest = skip_spaces(cmd + cmd_len);
  // Also truncate rest at line_end
  if (rest >= line_end) {
    rest = line_end;
  }

  // Sanitize the token:
  // Some serial setups can inject invisible non-ASCII bytes into the command
  // token. We only keep a conservative ASCII subset for command matching.
  char cmd_clean[32];
  size_t cmd_clean_len = 0;
  for (size_t i = 0; i < cmd_len && cmd_clean_len + 1 < sizeof(cmd_clean);
       i++) {
    unsigned char ch = (unsigned char)cmd[i];
    if ((ch >= (unsigned char)'a' && ch <= (unsigned char)'z') ||
        (ch >= (unsigned char)'0' && ch <= (unsigned char)'9') ||
        ch == (unsigned char)'_')
      cmd_clean[cmd_clean_len++] = (char)ch;
  }
  cmd_clean[cmd_clean_len] = '\0';

  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "service", 7) == 0) {
    cmd_service(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "date", 4) == 0) {
    cmd_date();
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "uname", 5) == 0) {
    cmd_uname(rest);
    return;
  }
  if (cmd_clean_len == 6 && kstrcmp_n(cmd_clean, "whoami", 6) == 0) {
    cmd_whoami(rest);
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "hostname", 8) == 0) {
    cmd_hostname(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "help", 4) == 0) {
    shell_help();
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "history", 7) == 0) {
    cmd_history();
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "clear", 5) == 0) {
    terminal_clear();
    serial_clear();
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "echo", 4) == 0) {
    log_writestring(rest);
    log_putchar('\n');
    return;
  }
  if (cmd_clean_len == 6 && kstrcmp_n(cmd_clean, "reboot", 6) == 0) {
    log_writestring("Rebooting...\n");
    reboot_now();
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "test_pbuf", 9) == 0) {
    cmd_test_pbuf();
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "eth_stat", 8) == 0) {
    cmd_eth_stat();
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "test_eth", 8) == 0) {
    cmd_test_eth();
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "arp_stat", 8) == 0) {
    cmd_arp_stat();
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "arp_whois", 9) == 0) {
    cmd_arp_whois(rest);
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "ip_stat", 7) == 0) {
    cmd_ip_stat();
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "ping", 4) == 0) {
    cmd_ping(rest);
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "ifconfig", 8) == 0) {
    cmd_ifconfig(rest);
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "udp_send", 8) == 0) {
    cmd_udp_send(rest);
    return;
  }
  if (cmd_clean_len == 10 && kstrcmp_n(cmd_clean, "tcp_listen", 10) == 0) {
    cmd_tcp_listen(rest);
    return;
  }
  if (cmd_clean_len == 11 && kstrcmp_n(cmd_clean, "tcp_connect", 11) == 0) {
    cmd_tcp_connect(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "wget", 4) == 0) {
    cmd_wget(rest);
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "httpd", 5) == 0) {
    cmd_httpd(rest);
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "http_get", 8) == 0) {
    cmd_http_get(rest);
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "tcp_stat", 8) == 0) {
    cmd_tcp_stat();
    return;
  }
  if (cmd_clean_len == 11 && kstrcmp_n(cmd_clean, "policy_stat", 11) == 0) {
    cmd_policy_stat(rest);
    return;
  }
  if (cmd_clean_len == 11 && kstrcmp_n(cmd_clean, "test_policy", 11) == 0) {
    cmd_test_policy(rest);
    return;
  }
  if (cmd_clean_len == 13 && kstrcmp_n(cmd_clean, "test_auth_add", 13) == 0) {
    cmd_test_auth_add(rest);
    return;
  }

  if (cmd_clean_len == 12 && kstrcmp_n(cmd_clean, "tcp_test_syn", 12) == 0) {
    cmd_tcp_test_syn(rest);
    return;
  }
  if (cmd_clean_len == 12 && kstrcmp_n(cmd_clean, "tcp_test_ack", 12) == 0) {
    cmd_tcp_test_ack(rest);
    return;
  }
  if (cmd_clean_len == 13 && kstrcmp_n(cmd_clean, "tcp_test_data", 13) == 0) {
    cmd_tcp_test_data(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "dhcp", 4) == 0) {
    cmd_dhcp();
    return;
  }
  if (cmd_clean_len == 3 && kstrcmp_n(cmd_clean, "dns", 3) == 0) {
    cmd_dns(rest);
    return;
  }
  if (cmd_clean_len == 6 && kstrcmp_n(cmd_clean, "netcfg", 6) == 0) {
    cmd_netcfg(rest);
    return;
  }
  if (cmd_clean_len == 10 && kstrcmp_n(cmd_clean, "dhcpd_stat", 10) == 0) {
    cmd_dhcpd_stat(rest);
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "dnsd_stat", 9) == 0) {
    cmd_dnsd_stat(rest);
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "auth_stat", 9) == 0) {
    cmd_auth_stat(rest);
    return;
  }

  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "http_stat", 9) == 0) {
    cmd_http_stat(rest);
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "http_test", 9) == 0) {
    cmd_http_test(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "edit", 4) == 0) {
    editor_open(rest);
    terminal_clear(); // Clear after exit
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "ticks", 5) == 0) {
    log_writestring("ticks=");
    log_write_u32(pit_ticks);
    log_putchar('\n');
    return;
  }
  if (cmd_clean_len == 6 && kstrcmp_n(cmd_clean, "uptime", 6) == 0) {
    uint32_t ms = (pit_ticks * 1000u) / PIT_HZ;
    log_writestring("uptime_ms=");
    log_write_u32(ms);
    log_putchar('\n');
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "ps", 2) == 0) {
    cmd_ps();
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "kill", 4) == 0) {
    cmd_kill(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "wait", 4) == 0) {
    cmd_wait(rest);
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "sleep", 5) == 0) {
    uint32_t ms = 0;
    if (!parse_u32(rest, &ms)) {
      log_writestring("Usage: sleep <ms>\n");
      return;
    }
    sleep_ms(ms);
    return;
  }
  if (cmd_clean_len == 3 && kstrcmp_n(cmd_clean, "a20", 3) == 0) {
    log_writestring("A20=");
    log_writestring(a20_is_enabled() ? "ON\n" : "OFF\n");
    return;
  }
  if (cmd_clean_len == 3 && kstrcmp_n(cmd_clean, "pci", 3) == 0) {
    pci_list_devices();
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "e1000", 5) == 0) {
    e1000_print_info();
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "e1000tx", 7) == 0) {
    cmd_e1000tx();
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "e1000rx", 7) == 0) {
    cmd_e1000rx();
    return;
  }
  if (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "e1000icr", 8) == 0) {
    cmd_e1000icr();
    return;
  }
  if (cmd_clean_len == 10 && kstrcmp_n(cmd_clean, "e1000watch", 10) == 0) {
    cmd_e1000watch();
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "e1000regs", 9) == 0) {
    cmd_e1000regs();
    return;
  }
  if (cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "e1000info", 9) == 0) {
    e1000_print_info();
    return;
  }
  if (cmd_clean_len == 11 && kstrcmp_n(cmd_clean, "e1000rxstat", 11) == 0) {
    cmd_e1000rxstat();
    return;
  }
  if (cmd_clean_len == 11 && kstrcmp_n(cmd_clean, "e1000reinit", 11) == 0) {
    cmd_e1000reinit();
    return;
  }
  if ((cmd_clean_len == 9 && kstrcmp_n(cmd_clean, "e1000loop", 9) == 0) ||
      (cmd_clean_len == 8 && kstrcmp_n(cmd_clean, "e100loop", 8) == 0)) {
    cmd_e1000loop(rest);
    return;
  }
  if (cmd_clean_len == 3 && kstrcmp_n(cmd_clean, "pwd", 3) == 0) {
    cmd_pwd();
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "cd", 2) == 0) {
    const char *arg = skip_spaces(rest);
    cmd_cd(arg);
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "ls", 2) == 0) {
    cmd_ls_path(rest);
    return;
  }
  if (cmd_clean_len == 3 && kstrcmp_n(cmd_clean, "cat", 3) == 0) {
    const char *fn = skip_spaces(rest);
    if (*fn == '\0') {
      log_writestring("Usage: cat <FILE.TXT>\n");
      return;
    }
    cmd_cat_path(fn);
    return;
  }
  if (cmd_clean_len == 6 && kstrcmp_n(cmd_clean, "create", 6) == 0) {
    const char *args = skip_spaces(rest);
    // Find space between fn and data
    const char *space = args;
    while (*space && *space != ' ')
      space++;
    if (*space == ' ') {
      char fn[32];
      int fn_len = (int)(space - args);
      if (fn_len > 31)
        fn_len = 31;
      for (int i = 0; i < fn_len; i++)
        fn[i] = args[i];
      fn[fn_len] = 0;

      const char *data = skip_spaces(space);
      uint32_t data_len = 0;
      while (data[data_len])
        data_len++;
      fat12_write_file(fn, (const uint8_t *)data, data_len);
    } else {
      log_writestring("Usage: create <file> <text>\n");
    }
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "cp", 2) == 0) {
    const char *fn = skip_spaces(rest);
    if (*fn == '\0') {
      log_writestring("Usage: cp <FILE>\n");
      return;
    }
    cmd_cp(fn);
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "files", 5) == 0) {
    cmd_files();
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "freeram", 7) == 0) {
    cmd_freeram(rest);
    return;
  }
  if (cmd_clean_len == 3 && kstrcmp_n(cmd_clean, "run", 3) == 0) {
    cmd_run(rest, is_background);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "run3", 4) == 0) {
    cmd_run3(rest, is_background);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "jobs", 4) == 0) {
    cmd_jobs();
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "touch", 5) == 0) {
    cmd_touch(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "grep", 4) == 0) {
    cmd_grep(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "head", 4) == 0) {
    cmd_head(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "tail", 4) == 0) {
    cmd_tail(rest);
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "wc", 2) == 0) {
    cmd_wc(rest);
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "hexdump", 7) == 0) {
    cmd_hexdump(rest);
    return;
  }
  if (cmd_clean_len == 7 && kstrcmp_n(cmd_clean, "strings", 7) == 0) {
    cmd_strings(rest);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "heap", 4) == 0) {
    uint32_t total = 0, used = 0, freeb = 0;
    heap_stats(&total, &used, &freeb);
    log_writestring("heap_total=");
    log_write_u32(total);
    log_writestring(" used=");
    log_write_u32(used);
    log_writestring(" free=");
    log_write_u32(freeb);
    log_putchar('\n');
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "alloc", 5) == 0) {
    uint32_t bytes = 0;
    if (!parse_u32(rest, &bytes)) {
      log_writestring("Usage: alloc <bytes>\n");
      return;
    }
    void *p = kmalloc(bytes);
    if (!p) {
      log_writestring("alloc failed\n");
      return;
    }
    int id = -1;
    for (int i = 0; i < ALLOC_SLOTS; i++) {
      if (alloc_slots[i] == (void *)0) {
        alloc_slots[i] = p;
        id = i;
        break;
      }
    }
    log_writestring("id=");
    log_write_u32((uint32_t)id);
    log_writestring(" ptr=");
    log_write_hex32((uint32_t)p);
    log_putchar('\n');
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "free", 4) == 0) {
    uint32_t id = 0;
    if (!parse_u32(rest, &id) || id >= ALLOC_SLOTS) {
      log_writestring("Usage: free <id>\n");
      return;
    }
    if (alloc_slots[id] == (void *)0) {
      log_writestring("free: empty slot\n");
      return;
    }
    kfree(alloc_slots[id]);
    alloc_slots[id] = (void *)0;
    log_writestring("freed\n");
    return;
  }
  if (cmd_clean_len == 5 && kstrcmp_n(cmd_clean, "mkdir", 5) == 0) {
    const char *dir_name = skip_spaces(rest);
    if (*dir_name == '\0') {
      log_writestring("Usage: mkdir <dir>\n");
      return;
    }
    struct fat12_ctx ctx;
    if (!fat12_init(&ctx)) {
      return;
    }
    // Resolve parent directory
    char dir_path[96];
    const char *name_part = 0;
    if (!fat12_split_path(dir_name, dir_path, sizeof(dir_path), &name_part) ||
        !name_part || *name_part == '\0') {
      log_writestring("mkdir: invalid path\n");
      fat12_deinit(&ctx);
      return;
    }
    uint16_t parent_dir = fat12_cwd_cluster;
    if (dir_path[0] == '/') {
      parent_dir = 0;
    }
    int ok = 0;
    if (dir_path[0] != '\0') {
      parent_dir = fat12_resolve_dir(&ctx, fat12_cwd_cluster, dir_path, &ok);
      if (!ok) {
        log_writestring("mkdir: parent not found\n");
        fat12_deinit(&ctx);
        return;
      }
    }
    if (fat12_create_dir(&ctx, parent_dir, name_part)) {
      fat12_flush_fat(&ctx);
      log_writestring("mkdir: created\n");
    } else {
      log_writestring("mkdir: failed (exists or no space)\n");
    }
    fat12_deinit(&ctx);
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "rm", 2) == 0) {
    const char *path = skip_spaces(rest);
    if (*path == '\0') {
      log_writestring("Usage: rm <file>\n");
      return;
    }
    struct fat12_ctx ctx;
    if (!fat12_init(&ctx)) {
      return;
    }
    // Resolve directory + filename
    char dir_path[96];
    const char *file_part = 0;
    if (!fat12_split_path(path, dir_path, sizeof(dir_path), &file_part) ||
        !file_part || *file_part == '\0') {
      log_writestring("rm: invalid path\n");
      fat12_deinit(&ctx);
      return;
    }
    uint16_t parent_dir = fat12_cwd_cluster;
    if (dir_path[0] == '/') {
      parent_dir = 0;
    }
    int ok = 0;
    if (dir_path[0] != '\0') {
      parent_dir = fat12_resolve_dir(&ctx, fat12_cwd_cluster, dir_path, &ok);
      if (!ok) {
        log_writestring("rm: not found\n");
        fat12_deinit(&ctx);
        return;
      }
    }
    uint8_t name83[11];
    fat12_to_83(file_part, name83);
    if (fat12_delete_entry(&ctx, parent_dir, name83)) {
      fat12_flush_fat(&ctx);
      log_writestring("rm: deleted\n");
    } else {
      log_writestring("rm: not found\n");
    }
    fat12_deinit(&ctx);
    return;
  }
  if (cmd_clean_len == 2 && kstrcmp_n(cmd_clean, "mv", 2) == 0) {
    const char *args = skip_spaces(rest);
    if (*args == '\0') {
      log_writestring("Usage: mv <src> <dst>\n");
      return;
    }
    // Find space between src and dst
    const char *space = args;
    while (*space && *space != ' ')
      space++;
    if (*space == '\0') {
      log_writestring("Usage: mv <src> <dst>\n");
      return;
    }
    size_t src_len = (size_t)(space - args);
    char src[96];
    if (src_len >= sizeof(src))
      src_len = sizeof(src) - 1;
    for (size_t i = 0; i < src_len; i++)
      src[i] = args[i];
    src[src_len] = '\0';
    const char *dst = skip_spaces(space);
    if (*dst == '\0') {
      log_writestring("Usage: mv <src> <dst>\n");
      return;
    }
    struct fat12_ctx ctx;
    if (!fat12_init(&ctx)) {
      return;
    }
    // Resolve source
    char src_dir[96];
    const char *src_file = 0;
    if (!fat12_split_path(src, src_dir, sizeof(src_dir), &src_file) ||
        !src_file || *src_file == '\0') {
      log_writestring("mv: invalid source\n");
      fat12_deinit(&ctx);
      return;
    }
    uint16_t src_parent = fat12_cwd_cluster;
    if (src_dir[0] == '/')
      src_parent = 0;
    int ok = 0;
    if (src_dir[0] != '\0') {
      src_parent = fat12_resolve_dir(&ctx, fat12_cwd_cluster, src_dir, &ok);
      if (!ok) {
        log_writestring("mv: source not found\n");
        fat12_deinit(&ctx);
        return;
      }
    }
    uint8_t src_name83[11];
    fat12_to_83(src_file, src_name83);
    // Read source directory
    uint8_t *src_buf = 0;
    uint32_t src_bytes = 0;
    int src_is_root = (src_parent == 0);
    if (src_is_root) {
      if (!fat12_read_root_dir(&ctx, &src_buf, &src_bytes)) {
        fat12_deinit(&ctx);
        return;
      }
    } else {
      if (!fat12_read_dir_cluster(&ctx, src_parent, &src_buf, &src_bytes)) {
        fat12_deinit(&ctx);
        return;
      }
    }
    // Find source entry
    uint32_t entries = src_bytes / 32u;
    struct fat12_dirent *src_ent = 0;
    for (uint32_t i = 0; i < entries; i++) {
      struct fat12_dirent *e = (struct fat12_dirent *)(src_buf + i * 32u);
      if (e->name[0] == 0x00)
        break;
      if (e->name[0] == 0xE5)
        continue;
      if (fat12_name_eq(e->name, src_name83)) {
        src_ent = e;
        break;
      }
    }
    if (!src_ent) {
      kfree(src_buf);
      log_writestring("mv: source not found\n");
      fat12_deinit(&ctx);
      return;
    }
    // Resolve destination
    char dst_dir[96];
    const char *dst_file = 0;
    if (!fat12_split_path(dst, dst_dir, sizeof(dst_dir), &dst_file) ||
        !dst_file || *dst_file == '\0') {
      kfree(src_buf);
      log_writestring("mv: invalid destination\n");
      fat12_deinit(&ctx);
      return;
    }
    uint16_t dst_parent = fat12_cwd_cluster;
    if (dst_dir[0] == '/')
      dst_parent = 0;
    if (dst_dir[0] != '\0') {
      dst_parent = fat12_resolve_dir(&ctx, fat12_cwd_cluster, dst_dir, &ok);
      if (!ok) {
        kfree(src_buf);
        log_writestring("mv: destination parent not found\n");
        fat12_deinit(&ctx);
        return;
      }
    }
    uint8_t dst_name83[11];
    fat12_to_83(dst_file, dst_name83);
    // Check if destination already exists
    struct fat12_dirent existing;
    if (fat12_find_in_dir(&ctx, dst_parent, dst_name83, &existing)) {
      kfree(src_buf);
      log_writestring("mv: destination exists\n");
      fat12_deinit(&ctx);
      return;
    }
    // Read destination directory
    uint8_t *dst_buf = 0;
    uint32_t dst_bytes = 0;
    int dst_is_root = (dst_parent == 0);
    if (dst_is_root) {
      if (!fat12_read_root_dir(&ctx, &dst_buf, &dst_bytes)) {
        kfree(src_buf);
        fat12_deinit(&ctx);
        return;
      }
    } else {
      if (!fat12_read_dir_cluster(&ctx, dst_parent, &dst_buf, &dst_bytes)) {
        kfree(src_buf);
        fat12_deinit(&ctx);
        return;
      }
    }
    // Find free slot in destination
    struct fat12_dirent *dst_slot =
        fat12_find_free_slot(&ctx, dst_parent, dst_buf, dst_bytes);
    if (!dst_slot) {
      kfree(src_buf);
      kfree(dst_buf);
      log_writestring("mv: destination full\n");
      fat12_deinit(&ctx);
      return;
    }
    // Copy entry to destination
    *dst_slot = *src_ent;
    mem_copy(dst_slot->name, dst_name83, 11);
    // Mark source as deleted
    src_ent->name[0] = 0xE5;
    // Write both directories
    if (src_is_root) {
      for (uint16_t i = 0; i < ctx.root_sectors; i++) {
        uint32_t lba = ctx.root_lba + i;
        ramdisk_write_sector_lba(lba, src_buf + (uint32_t)i * 512u);
      }
    } else {
      fat12_write_dir_cluster(&ctx, src_parent, src_buf, src_bytes);
    }
    if (dst_is_root) {
      for (uint16_t i = 0; i < ctx.root_sectors; i++) {
        uint32_t lba = ctx.root_lba + i;
        ramdisk_write_sector_lba(lba, dst_buf + (uint32_t)i * 512u);
      }
    } else {
      fat12_write_dir_cluster(&ctx, dst_parent, dst_buf, dst_bytes);
    }
    kfree(src_buf);
    kfree(dst_buf);
    log_writestring("mv: moved\n");
    fat12_deinit(&ctx);
    return;
  }
  if (cmd_clean_len == 4 && kstrcmp_n(cmd_clean, "find", 4) == 0) {
    const char *pattern = skip_spaces(rest);
    if (*pattern == '\0') {
      log_writestring("Usage: find <pattern>\n");
      return;
    }
    // Simple recursive search: match if pattern appears in filename
    struct fat12_ctx ctx;
    if (!fat12_init(&ctx)) {
      return;
    }
    fat12_find_recursive(&ctx, 0, pattern, "/");
    fat12_deinit(&ctx);
    return;
  }

  log_writestring("Unknown command: ");
  // Print only the (sanitized) token
  for (size_t i = 0; i < cmd_clean_len; i++) {
    log_putchar(cmd_clean[i]);
  }
  log_putchar('\n');
}

static void shell_execute(const char *line) {
  const char *s = skip_spaces(line);
  if (*s == '\0') {
    return;
  }

  // Pre-parse for redirection
  char redir_fn[64];
  int redir_append = 0;
  const char *redir_op = 0;

  // Look for > or >>
  const char *curr = s;
  while (*curr) {
    if (*curr == '>') {
      redir_op = curr;
      if (curr[1] == '>') {
        redir_append = 1;
      }
      break;
    }
    curr++;
  }

  char line_buf[256];
  kstrncpy(line_buf, s, sizeof(line_buf));

  if (redir_op) {
    // Truncate the line_buf at the redirection operator
    size_t op_pos = (size_t)(redir_op - s);
    if (op_pos < sizeof(line_buf)) {
      line_buf[op_pos] = '\0';
    }

    // Extract filename
    const char *fn_start = skip_spaces(redir_op + (redir_append ? 2 : 1));
    int fi = 0;
    while (fn_start[fi] && (unsigned char)fn_start[fi] > ' ' &&
           fi < (int)sizeof(redir_fn) - 1) {
      redir_fn[fi] = fn_start[fi];
      fi++;
    }
    redir_fn[fi] = '\0';
  } else {
    redir_fn[0] = '\0';
  }

  // If redirecting, setup buffer
  if (redir_op && redir_fn[0]) {
    shell_redirect_ptr = 0;
    shell_redirect_active = 1;
    if (redir_append) {
      uint8_t *old_data = 0;
      uint32_t old_size = 0;
      if (fat12_read_file_to_ram(redir_fn, &old_data, &old_size)) {
        size_t to_copy = (size_t)old_size;
        if (to_copy > sizeof(shell_redirect_buf))
          to_copy = sizeof(shell_redirect_buf);
        kmemcpy((uint8_t *)shell_redirect_buf, old_data, (uint32_t)to_copy);
        shell_redirect_ptr = to_copy;
        kfree(old_data);
      }
    }
  }

  shell_dispatch(line_buf);

  // After execution:
  if (shell_redirect_active) {
    shell_redirect_active = 0;
    if (redir_fn[0]) {
      fat12_write_file(redir_fn, (const uint8_t *)shell_redirect_buf,
                       (uint32_t)shell_redirect_ptr);
    }
  }
}

void kernel_main() {
  // Clear BSS section first thing
  extern uint8_t sbss, ebss;
  uint8_t *p_bss = &sbss;
  while (p_bss < &ebss) {
    *p_bss++ = 0;
  }

  // Very early: use direct port I/O before any initialization
  // Output 'M' to confirm we reached kernel_main
  outb(0x3F8 + 3, 0x80); // Enable DLAB
  outb(0x3F8 + 0, 0x03); // Divisor lo
  outb(0x3F8 + 1, 0x00); // Divisor hi
  outb(0x3F8 + 3, 0x03); // 8 bits, no parity
  outb(0x3F8 + 2, 0xC7); // Enable FIFO

  // Small delay
  for (volatile int i = 0; i < 1000; i++)
    ;

  outb(0x3F8, 'M');
  for (volatile int i = 0; i < 1000; i++)
    ;

  outb(0x3F8, '3'); // Step 3: BSS cleared

  // Initialize heap immediately after BSS clearing
  // (heap_head is a static variable in BSS, so we must init it right after
  // zeroing)
  heap_init();
  serial_initialize();

  // Early debug: output 'S' after serial init
  serial_putchar('S');
  serial_putchar('\n');
  serial_putchar('\r');

  terminal_initialize();
  gdt_install_and_tss();

  log_writestring("Welcome to AJOS (A Simple Operating System)!\n");
  log_writestring("Kernel loaded successfully.\n\n");
  log_writestring("Build: " __DATE__ " " __TIME__ "\n\n");

  // Boot drive passed by BIOS is stored by the bootloader at 0x0500.
  boot_drive = *(volatile uint8_t *)0x0500;
  uint16_t raw_ramdisk = *(volatile uint16_t *)0x0501;

  // Debug: check raw value at 0x0501
  log_writestring("ramdisk: raw_value_at_0x0501=");
  log_write_u32((uint32_t)raw_ramdisk);
  log_putchar('\n');

  if (boot_drive != 0x00 && boot_drive != 0x01) {
    boot_drive = 0x00;
  }

  // Use the value from bootloader if it's valid (non-zero)
  // The bootloader sets this to 2880 for a standard 1.44MB floppy
  // ramdisk_sectors is now volatile to prevent optimization issues
  if (raw_ramdisk != 0 && raw_ramdisk <= 2880) {
    ramdisk_sectors = raw_ramdisk;
    log_writestring("ramdisk: assigned sectors=");
    log_write_u32((uint32_t)ramdisk_sectors);
    log_putchar('\n');
  } else {
    // If bootloader value is invalid, default to 2880 for standard floppy
    log_writestring("ramdisk: bootloader value invalid (");
    log_write_u32((uint32_t)raw_ramdisk);
    log_writestring("), defaulting to 2880\n");
    ramdisk_sectors = 2880;
  }

  // Debug ramdisk
  log_writestring("ramdisk: final sectors=");
  log_write_u32((uint32_t)ramdisk_sectors);
  log_writestring(" drive=");
  log_write_u32((uint32_t)ramdisk_drive);
  log_putchar('\n');

  // Final check - if still 0, something is very wrong
  if (ramdisk_sectors == 0 && raw_ramdisk != 0) {
    log_writestring("ramdisk: CRITICAL - assignment failed! raw=");
    log_write_u32((uint32_t)raw_ramdisk);
    log_writestring(" addr=");
    log_write_hex32((uint32_t)&ramdisk_sectors);
    log_writestring(" before=");
    log_write_u32((uint32_t)ramdisk_sectors);
    log_putchar('\n');
    // Try multiple assignment methods
    ramdisk_sectors = raw_ramdisk;
    __asm__ volatile("movw %0, %1"
                     : "=m"(ramdisk_sectors)
                     : "r"(raw_ramdisk)
                     : "memory");
    log_writestring("ramdisk: after asm assignment=");
    log_write_u32((uint32_t)ramdisk_sectors);
    log_putchar('\n');
  }

  interrupts_init();

  // Debug: check heap_head before paging_init
  outb(0x3F8, 'P');
  uint32_t hh_before = (uint32_t)heap_head;
  outb(0x3F8, '0' + ((hh_before >> 20) & 0xF));
  outb(0x3F8, '0' + ((hh_before >> 16) & 0xF));

  paging_init();

  // Debug: check heap_head after paging_init
  outb(0x3F8, 'Q');
  uint32_t hh_after = (uint32_t)heap_head;
  outb(0x3F8, '0' + ((hh_after >> 20) & 0xF));
  outb(0x3F8, '0' + ((hh_after >> 16) & 0xF));
  process_init();
  socket_init();
  e1000_probe();
  pbuf_init();
  arp_init();
  ip4_init();
  dns_init();
  tcp_init();
  http_init();
  dhcpd_init();
  dnsd_init();
  auth_init();

  // network_auto_setup();

  while (1) {
    char line[LINE_MAX];
    char prompt[160];
    build_prompt(prompt, sizeof(prompt));
    readline(prompt, line, sizeof(line));
    history_add(line);
    shell_execute(line);
  }
}

